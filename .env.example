# Client-side variables. Lovable Cloud injects these at build time once the
# backend is enabled — copy this file to .env.local only for local development.
# .env* is gitignored. Never put a secret key here: everything prefixed VITE_
# is compiled into the browser bundle.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side secrets are NOT set here. They live in the Supabase edge function
# secret store, set through Lovable — see docs/COURSE_PLATFORM_SETUP.md §4:
#   STRIPE_SECRET_KEY        (sk_test_... until launch)
#   STRIPE_WEBHOOK_SECRET    (whsec_...)
#   SITE_URL
