# Client-side variables. Lovable Cloud injects these at build time once the
# backend is enabled — copy this file to .env.local only for local development.
# .env* is gitignored. Never put a secret key here: everything prefixed VITE_
# is compiled into the browser bundle.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Stripe publishable key from Lovable Payments. Lovable writes the pk_test_
# key into .env.development and the pk_live_ key into .env.production at
# go-live; a build without it shows "checkout is not available".
VITE_PAYMENTS_CLIENT_TOKEN=

# Server-side secrets are NOT set here. Lovable Payments sets these in the
# edge function secret store (docs/COURSE_PLATFORM_SETUP.md §4):
#   STRIPE_SANDBOX_API_KEY, PAYMENTS_SANDBOX_WEBHOOK_SECRET, LOVABLE_API_KEY
#   STRIPE_LIVE_API_KEY, PAYMENTS_LIVE_WEBHOOK_SECRET   (added at go-live)
# Set by hand, through Lovable:
#   SITE_URL   https://learn.livinglifebalancedllb.com once live
